[Unit]
Description=ALLFDE self-hosted Node service
After=network.target

[Service]
Type=simple
User=allfde
Group=allfde
WorkingDirectory=/srv/allfde
EnvironmentFile=/etc/allfde/allfde.env
Environment=NODE_ENV=production
Environment=ALLFDE_STATIC_SITE=1
Environment=ALLFDE_STATIC_ROOT=/srv/allfde
Environment=ALLFDE_DATA=/srv/allfde/data
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /srv/allfde/server/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/allfde/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
