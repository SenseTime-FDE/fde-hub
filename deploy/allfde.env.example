# Copy to /etc/allfde/allfde.env and chmod 640. Never commit the real file.
HOST=127.0.0.1
PORT=3000
ALLFDE_ORIGIN=https://allfde.com
ALLFDE_TRUST_PROXY=1
ALLFDE_RELEASE=replace-with-git-sha

# Set these only during the one-time admin initialization command.
# ALLFDE_ADMIN=admin
# ALLFDE_ADMIN_PASSWORD=use-a-random-password

# Optional override; the systemd unit supplies the production default.
# ALLFDE_DATA=/srv/allfde/data
